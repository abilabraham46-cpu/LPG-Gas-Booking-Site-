{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start PHP dev server (project root)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\start-server.ps1",
        "-Port",
        "3000"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}